<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - <%= invoice.invoice_number || "" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <%
      const amount = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? Math.round(number).toLocaleString("en-IN") : "0";
      };
      const date = (value) => {
        if (!value) return "-";
        const parsed = new Date(value);
        return Number.isNaN(parsed.getTime()) ? String(value) : parsed.toLocaleDateString("en-GB", {
          day: "2-digit", month: "2-digit", year: "numeric",
        });
      };
      const customerName = `${invoice.first_name || ""} ${invoice.last_name || ""}`.trim() || invoice.customer_name || "Customer";
      const customerAddress = [invoice.address, invoice.city, invoice.state, invoice.pincode].filter(Boolean).join(", ");
      const paymentStatus = invoice.payment_status || "Pending";
      const paymentClass = String(paymentStatus).toLowerCase();
      const subtotal = invoice.subtotal || invoice.total_amount;
      const itemDiscount = Number(invoice.discount_total || 0);
      const customerDiscount = Number(invoice.extra_discount || 0);
    %>

    <style>
      :root {
        --primary: #7c3aed;
        --primary-soft: #f5f3ff;
        --primary-gradient: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #4f46e5 100%);
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-400: #94a3b8;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --input-bg: #f8fafc;
        --paid: #047857;
        --paid-bg: #ecfdf5;
        --paid-border: #a7f3d0;
        --partial: #a16207;
        --partial-bg: #fefce8;
        --partial-border: #fde68a;
        --pending: #be123c;
        --pending-bg: #fff1f2;
        --pending-border: #fecdd3;
      }

      * { box-sizing: border-box; }
      @page { margin: 0; }
      html, body {
        margin: 0;
        padding: 0;
        background: #fff;
        color: var(--slate-900);
        font-family: "Poppins", Arial, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .invoice-paper { width: 100%; padding: 24px; }
      .header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-bottom: 4px; }
      .logo-wrap { display: flex; align-items: center; min-width: 150px; }
      .logo-wrap img { display: block; width: auto; height: auto; max-width: 180px; max-height: 56px; object-fit: contain; }
      .logo-fallback {
        display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
        border: 1px solid #ddd6fe; border-radius: 12px; background: var(--primary-soft);
        color: #6d28d9; font-size: 14px; font-weight: 700;
      }
      .logo-fallback .inline-icon { color: var(--primary); }
      .company-info { text-align: right; }
      .company-info h1 { margin: 0; color: var(--slate-900); font-size: 28px; font-weight: 900; letter-spacing: -0.5px; line-height: 1.2; }
      .company-info p {
        display: flex; align-items: center; justify-content: flex-end; gap: 6px;
        margin: 2px 0 0; color: var(--slate-500); font-size: 11px; font-weight: 500;
      }
      .inline-icon { width: 14px; height: 14px; flex: 0 0 14px; color: var(--slate-400); }

      .title-row { display: flex; align-items: center; gap: 12px; padding: 20px 0 8px; }
      .title-bar { height: 10px; border-radius: 999px; background: var(--primary-gradient); }
      .title-bar.left { flex: 1; }
      .title-bar.right { width: 64px; }
      .title-row h2 { margin: 0; padding: 0 8px; color: var(--slate-900); font-size: 34px; font-weight: 900; letter-spacing: 2px; line-height: 1; }

      .details-grid {
        display: grid; grid-template-columns: minmax(0, 7fr) minmax(245px, 5fr);
        gap: 24px; align-items: start; padding-top: 24px;
      }
      .eyebrow { display: block; margin-bottom: 8px; color: var(--slate-400); font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .customer h3 { margin: 0 0 8px; color: var(--slate-900); font-size: 18px; font-weight: 700; letter-spacing: -0.2px; }
      .customer p { margin: 0 0 7px; color: var(--slate-500); font-size: 11px; font-weight: 500; line-height: 1.65; }
      .customer .phone { display: flex; align-items: center; gap: 6px; color: var(--slate-700); }
      .customer .phone .inline-icon { color: var(--primary); }
      .customer .gst { padding-top: 2px; color: var(--slate-600); }
      .customer .gst strong { color: var(--slate-800); font-weight: 600; }

      .invoice-details { padding: 16px; border: 1px solid var(--slate-200); border-radius: 16px; background: var(--input-bg); font-size: 11px; }
      .invoice-details .heading {
        display: block; margin-bottom: 10px; padding-bottom: 7px; border-bottom: 1px solid var(--slate-200);
        color: var(--slate-600); font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
      }
      .detail-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 9px; }
      .detail-label { color: var(--slate-500); font-weight: 500; }
      .detail-value { color: var(--slate-800); font-weight: 600; text-align: right; }
      .detail-value.invoice-number { color: var(--slate-900); font-weight: 700; }
      .status {
        padding: 2px 9px; border: 1px solid var(--pending-border); border-radius: 999px;
        background: var(--pending-bg); color: var(--pending); font-size: 9px; font-weight: 700;
        letter-spacing: 0.8px; text-transform: uppercase;
      }
      .status.paid { border-color: var(--paid-border); background: var(--paid-bg); color: var(--paid); }
      .status.partial { border-color: var(--partial-border); background: var(--partial-bg); color: var(--partial); }

      .table-card { margin-top: 28px; overflow: hidden; border: 1px solid var(--slate-100); border-radius: 16px; }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      thead { display: table-header-group; }
      tr { break-inside: avoid; }
      th {
        padding: 13px 16px; background: var(--primary-gradient); color: #fff;
        font-size: 10px; font-weight: 700; letter-spacing: 0.8px; text-align: left; text-transform: uppercase;
      }
      th:nth-child(1), td:nth-child(1) { width: 8%; text-align: center; }
      th:nth-child(2), td:nth-child(2) { width: 42%; }
      th:nth-child(3), td:nth-child(3) { width: 17%; text-align: center; }
      th:nth-child(4), td:nth-child(4) { width: 13%; text-align: center; }
      th:nth-child(5), td:nth-child(5) { width: 20%; text-align: right; }
      td { padding: 13px 16px; border-bottom: 1px solid var(--slate-100); color: var(--slate-700); font-size: 11px; font-weight: 600; vertical-align: middle; }
      tbody tr:last-child td { border-bottom: 0; }
      .serial { color: var(--slate-400); font-weight: 500; }
      .item-name { color: var(--slate-900); font-size: 13px; font-weight: 600; line-height: 1.35; }
      .item-meta { margin-top: 3px; color: var(--slate-400); font-size: 10px; font-weight: 500; }
      .line-total { color: var(--slate-900); font-weight: 700; }
      .empty-row { padding: 24px; color: var(--slate-400); font-weight: 500; text-align: center !important; }

      .totals-wrap { display: flex; justify-content: flex-end; margin-top: 28px; break-inside: avoid; }
      .totals { width: 41.6667%; min-width: 270px; color: var(--slate-500); font-size: 11px; }
      .total-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 4px 0; }
      .total-row .label { font-weight: 500; }
      .total-row .value { color: var(--slate-800); font-weight: 600; text-align: right; }
      .total-row.discount .value { color: var(--paid); }
      .total-row.remaining { padding: 5px 0 9px; font-size: 10px; }
      .total-row.remaining .value { color: var(--pending); font-weight: 700; }
      .payable {
        display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px;
        border-radius: 12px; background: var(--primary-gradient); color: #fff;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.18);
      }
      .payable .label { font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .payable .value { font-size: 15px; font-weight: 700; }

      .closing {
        display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: end;
        margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--slate-200);
        color: var(--slate-500); font-size: 10px; font-weight: 500; break-inside: avoid;
      }
      .thanks { margin: 0 0 16px; color: var(--slate-800); font-size: 14px; font-weight: 700; }
      .terms-title { margin: 0 0 4px; color: var(--slate-600); font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; }
      .terms-text { margin: 0; line-height: 1.7; }
      .signature { position: relative; top: -20px; text-align: right; }
      .signature .brand { display: block; margin-bottom: 3px; color: var(--slate-700); font-size: 19px; font-weight: 700; letter-spacing: 1px; }
      .signature .label { display: block; color: var(--slate-700); font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; }
    </style>
  </head>
  <body>
    <main class="invoice-paper">
      <header class="header">
        <div class="logo-wrap">
          <% if (owner.logo) { %>
            <img src="<%= owner.logo %>" alt="<%= owner.shop_name || 'Store logo' %>" />
          <% } else { %>
            <div class="logo-fallback">
              <svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l1-5h16l1 5" /><path d="M5 13v8h14v-8" /><path d="M9 21v-6h6v6" /><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
              </svg>
              <span><%= owner.shop_name || "Store Mitraa" %></span>
            </div>
          <% } %>
        </div>
        <div class="company-info">
          <h1><%= owner.shop_name || "Store Mitraa" %></h1>
          <% if (owner.owner_name) { %><p>Proprietor: <%= owner.owner_name %></p><% } %>
          <% if (owner.email) { %>
            <p><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg><span><%= owner.email %></span></p>
          <% } %>
          <% if (owner.phone) { %>
            <p><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg><span><%= owner.phone %></span></p>
          <% } %>
        </div>
      </header>

      <section class="title-row" aria-label="Invoice title"><div class="title-bar left"></div><h2>INVOICE</h2><div class="title-bar right"></div></section>

      <section class="details-grid">
        <div class="customer">
          <span class="eyebrow">Invoice To:</span>
          <h3><%= customerName %></h3>
          <% if (invoice.phone_number) { %>
            <p class="phone"><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg><span><%= invoice.phone_number %></span></p>
          <% } %>
          <p><%= customerAddress || "Address not added" %></p>
          <% if (invoice.gst_number) { %><p class="gst">GST: <strong><%= invoice.gst_number %></strong></p><% } %>
        </div>
        <div class="invoice-details">
          <span class="heading">Invoice Details</span>
          <div class="detail-row"><span class="detail-label">Invoice#</span><span class="detail-value invoice-number"><%= invoice.invoice_number || "" %></span></div>
          <div class="detail-row"><span class="detail-label">Date</span><span class="detail-value"><%= date(invoice.invoice_date || invoice.created_at) %></span></div>
          <div class="detail-row"><span class="detail-label">Payment</span><span class="status <%= paymentClass %>"><%= paymentStatus %></span></div>
          <div class="detail-row"><span class="detail-label">Mode</span><span class="detail-value" style="text-transform: uppercase"><%= invoice.payment_mode || "Cash" %></span></div>
        </div>
      </section>

      <section class="table-card">
        <table>
          <thead><tr><th>SL.</th><th>Item Description</th><th>MRP</th><th>Qty.</th><th>Total</th></tr></thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
              <tr><td colspan="5" class="empty-row">No item details found.</td></tr>
            <% } else { %>
              <% items.forEach((item, index) => {
                const rate = Number(item.selling_price || item.price || 0);
                const lineTotal = Number(item.line_total || item.total || (Number(item.quantity || 0) * rate) || 0);
                const sku = item.product_sku || item.sku || "-";
              %>
                <tr>
                  <td class="serial"><%= index + 1 %></td>
                  <td><div class="item-name"><%= item.product_name || "Product" %></div><div class="item-meta">Code: <%= sku %> &middot; Rate: &#8377;<%= amount(rate) %></div></td>
                  <td>&#8377;<%= amount(rate) %></td><td><%= item.quantity %></td><td class="line-total">&#8377;<%= amount(lineTotal) %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </section>

      <section class="totals-wrap">
        <div class="totals">
          <div class="total-row"><span class="label">Sub Total:</span><span class="value">&#8377;<%= amount(subtotal) %></span></div>
          <div class="total-row"><span class="label">Tax:</span><span class="value">&#8377;<%= amount(invoice.tax_total) %></span></div>
          <% if (itemDiscount > 0) { %><div class="total-row discount"><span class="label"><%= customerDiscount > 0 ? "Item Discount:" : "Total Discount:" %></span><span class="value">-&#8377;<%= amount(itemDiscount) %></span></div><% } %>
          <% if (customerDiscount > 0) { %><div class="total-row discount"><span class="label">Customer Discount:</span><span class="value">-&#8377;<%= amount(customerDiscount) %></span></div><% } %>
          <div class="total-row"><span class="label">Total Billed Amount:</span><span class="value">&#8377;<%= amount(invoice.total_amount) %></span></div>
          <div class="total-row"><span class="label">Paid:</span><span class="value">&#8377;<%= amount(invoice.paid_amount) %></span></div>
          <div class="total-row remaining"><span class="label">Remaining</span><span class="value">&#8377;<%= amount(invoice.remaining_amount) %></span></div>
          <div class="payable"><span class="label">Total Payable</span><span class="value">&#8377;<%= amount(invoice.total_amount) %></span></div>
        </div>
      </section>

      <footer class="closing">
        <div><p class="thanks">Thank you for your business</p><p class="terms-title">Terms &amp; Conditions</p><p class="terms-text">Goods once sold will not be taken back unless otherwise agreed. Please verify all items at the time of billing. Payment related issues should be referenced with the invoice number.</p></div>
        <div class="signature"><span class="brand"><%= owner.shop_name || "Store Mitraa" %></span><span class="label">Authorised Sign</span></div>
      </footer>
    </main>
  </body>
</html>
